# Gemini (Google AI Studio — aistudio.google.com)
GEMINI_API_KEY=

# Pinecone (pinecone.io)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=horror-films

# Firecrawl (firecrawl.dev) — for data pipeline scripts only
FIRECRAWL_API_KEY=

# Postgres (Neon — neon.tech, free tier, Vercel integration)
DATABASE_URL=

# Upstash Redis (upstash.com, Vercel integration)
REDIS_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
