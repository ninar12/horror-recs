# Gemini (Google AI Studio — aistudio.google.com)
GEMINI_API_KEY=

# Pinecone (pinecone.io)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=horror-films

# TMDb (themoviedb.org) — primary film data source, free
# Use the "API Read Access Token" (long JWT) from themoviedb.org/settings/api — NOT the short API Key
TMDB_READ_TOKEN=

# Firecrawl (firecrawl.dev) — enrichment only (themes/atmosphere), optional
FIRECRAWL_API_KEY=

# Postgres (Neon — neon.tech, free tier, Vercel integration)
DATABASE_URL=

# Upstash Redis (upstash.com, Vercel integration)
REDIS_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
